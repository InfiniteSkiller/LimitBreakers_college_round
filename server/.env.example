PORT=3001
MODERATOR_SECRET_TOKEN=moderator-secret-token-2026

# --- Blockchain (optional). Leave CHAIN_ENABLED unset/false to run fully off-chain. ---
# CHAIN_ENABLED=true
# CHAIN_RPC_URL=http://127.0.0.1:8545
# Must be the SAME wallet that ran blockchain/scripts/deploy-and-configure.ts
# (it is the Semaphore group admin and the IncognitoReporting owner).
# CHAIN_PRIVATE_KEY=0x...        # never commit a real key
# SEMAPHORE_ADDRESS=0x...
# REPORTING_ADDRESS=0x...
# SEMAPHORE_GROUP_ID=0
# Finite allow-lists for scopes that can lazily create on-chain topics.
# Topic resolution is public in this prototype; do not allow arbitrary periods on a funded wallet.
ALLOWED_CATEGORIES=teaching,administration,facilities,safety,welfare
ALLOWED_PERIODS=2026-Q3,2026-Q4,2026-10
